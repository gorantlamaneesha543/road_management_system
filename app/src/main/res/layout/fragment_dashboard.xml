<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="3dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Road Condition Dashboard"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Inspections: 0"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/tvDamages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Damages Detected: 0"
                    android:textSize="16sp"
                    android:textColor="@color/error"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/tvPotholes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Potholes: 0"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/tvCracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cracks: 0"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/tvHighRisk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High Severity Cases: 0"
                    android:textSize="16sp"
                    android:textColor="@color/error"
                    android:textStyle="bold"
                    android:padding="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="REFRESH DASHBOARD"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="10dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
